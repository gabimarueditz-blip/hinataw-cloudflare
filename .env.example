CACHE_ENABLED=false
DEFAULT_REDIS_TTL=900
UPSTASH_REDIS_REST_URL=YOUR_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN
PORT=4000

# Feedback form -> owner email (Resend)
# FEEDBACK_TO_EMAIL is the Gmail inbox that receives reports.
FEEDBACK_TO_EMAIL=hinataw.exe@gmail.com
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Use onboarding@resend.dev until you verify your own sending domain.
FEEDBACK_FROM_EMAIL=Hinataw.exe <onboarding@resend.dev>
# Owner portal password (server-side only, never sent to the browser)
ADMIN_PASSWORD=your-password
